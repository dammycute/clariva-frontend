# Address of the Clariva API, including /api. No trailing slash.
# Local:      http://localhost:8000/api
# Production: https://<your-api-domain>/api   (set this in the Vercel project settings)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# The domain schools get their own address on: queens.<this domain>.
# Leave it empty in development and use <school>.localhost:3000 instead.
NEXT_PUBLIC_PLATFORM_DOMAIN=
